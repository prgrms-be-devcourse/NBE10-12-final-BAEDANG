# ============================================================================
#  이 파일을 복사해서 .env.local 을 만드세요.
#      cp .env.example .env.local
#
#  .env.local 은 절대 커밋하지 않습니다 (.gitignore 에 등록되어 있습니다).
#  Next.js는 front/ 안의 .env.local 을 자동으로 읽습니다(루트 .env 와는 별개).
# ============================================================================

# 프론트엔드가 호출하는 백엔드 API 주소. 비워두면(값이 없으면) src/lib/api.ts가
# http://localhost:8080 으로 기본값을 씁니다 — 로컬에서 백엔드를 직접 띄워
# 개발할 때는 이 값을 아예 비워두거나 지우면 됩니다.
NEXT_PUBLIC_API_BASE_URL=http://54.180.217.176:8080
