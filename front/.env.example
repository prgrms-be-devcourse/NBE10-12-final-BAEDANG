# ============================================================================
#  이 파일을 복사해서 .env.local 을 만드세요.
#      cp .env.example .env.local
#
#  .env.local 은 절대 커밋하지 않습니다 (.gitignore 에 등록되어 있습니다).
#  Next.js는 front/ 안의 .env.local 을 자동으로 읽습니다(루트 .env 와는 별개).
# ============================================================================

# 프론트엔드가 호출하는 백엔드 API 주소. 비워두면(값이 없으면) src/lib/api.ts가
# http://localhost:8080 으로 기본값을 씁니다 — 로컬에서 백엔드를 직접 띄워
# 개발할 때는 이 값을 아예 비워두거나 지우면 됩니다.
#
# 팀 공용 개발 서버(EC2) 주소처럼 실제 인프라 값은 커밋되는 이 예시 파일에
# 적지 않습니다 — 팀 채널 등에서 확인한 뒤, 각자의 .env.local 에만 채워
# 넣으세요.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 인증 중계 전용 서버 환경변수. NEXT_PUBLIC_ 접두사를 붙이지 않습니다.
# 배포에서는 NPMplus에 연결된 HTTPS 백엔드 주소와 정확한 Vercel Origin을 지정합니다.
# HTTP 예외는 프론트·백엔드가 모두 localhost/127.0.0.1인 로컬 실행에만 적용합니다.
AUTH_BACKEND_URL=http://localhost:8080
AUTH_PUBLIC_ORIGIN=http://localhost:3000
