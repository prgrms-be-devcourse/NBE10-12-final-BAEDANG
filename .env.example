# ============================================================================
#  이 파일을 복사해서 .env 를 만드세요.
#      cp .env.example .env

#  /NBE10-12-final-baedang 프로젝트 폴더에 위치 - back/front/infra/docs env
#
#  .env 는 절대 커밋하지 않습니다 (.gitignore 에 등록되어 있습니다).
#  개발용 대역(Fake) 구현체가 없으므로, 아래 토스 키를 채우고 TOSS_ENABLED=true
#  로 설정하지 않으면 백엔드가 기동하지 않습니다.
# ============================================================================

# [주의 - Spring Boot 는 .env 를 자동으로 읽지 않습니다]
#   셋 중 하나를 쓰세요.
#     1) IntelliJ 실행 구성 -> Environment variables 에 직접 입력  (가장 간단)
#     2) IntelliJ EnvFile 플러그인으로 이 파일 지정
#     3) Docker 로 앱까지 띄울 때는 compose 의 env_file 이 알아서 넣어줍니다
#
#   !! docker compose 는 "명령을 실행한 디렉터리"의 .env 를 읽습니다.
#      우리 compose 파일은 infra/ 에 있으므로 `cd infra && docker compose up -d`
#      로 띄우면 이 루트 .env 가 아니라 infra/.env 를 찾습니다.
#      지금은 compose 가 환경변수를 안 쓰고 값을 직접 들고 있어서 문제없습니다.
#      나중에 compose 에서 ${...} 를 쓰게 되면
#        docker compose --env-file ../.env up -d
#      처럼 명시하거나 compose 파일을 루트로 옮기세요.

# ── 토스증권 Open API ────────────────────────────────────────────────────────
# 발급: 토스증권 WTS 로그인 → 설정 → Open API
# 주의 1) 반드시 예수금 0원 · 보유종목 0개인 전용 계좌로 발급받으세요.
#        기존 실거래 계좌로 발급하면 이 키로 실제 주문이 나갈 수 있습니다.
# 주의 2) 같은 화면 하단 "허용 IP 관리"에 본인 공인 IP를 등록해야 합니다.
#        미등록 IP 는 403 edge-blocked 로 차단됩니다.
#        IP 확인: https://ifconfig.me
# 두 값을 채운 뒤 TOSS_ENABLE도 true 로 바꿔야 실제 Toss API 를 씁니다.
# 상위 종목 과거 일봉 200일치 초기 시드 적재 관리자 API 활성화 여부
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ENABLED=true
TOSS_SEED_DAILY_CANDLES=false

# 기동 시 1회 수동 적재 트리거(StockMasterLoadRunner).
# 주간 스케줄(월 07:00/08:00/21:00 KST)을 기다리지 않고 초기 데이터를 채울 때만 true 로 두고,
# 적재가 끝나면 다시 false 로 되돌리세요. TOSS_ENABLED=true 도 함께 필요합니다.
TOSS_LOAD_STOCK_MASTER=false
TOSS_LOAD_STOCK_MASTER_DETAIL=false
TOSS_LOAD_STOCK_RANKING=false

# ── PostgreSQL (docker compose up -d 로 띄운 로컬 DB) ─────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/trading
DB_USERNAME=trading
DB_PASSWORD=trading

# ── CORS ─────────────────────────────────────────────────────────────────────
# 콤마로 여러 오리진을 지정할 수 있습니다. 비워두면 로컬 프론트(localhost:3000)만 허용됩니다.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── 수집 설정 ────────────────────────────────────────────────────────────────
# 시세 수집 주기(초). 시장별 100종목 배치 1콜이라 5초여도 한도의 1.3% 입니다.
QUOTE_POLL_INTERVAL_SECONDS=5
# 시장별 수집 대상 종목 수 (거래대금 상위 100. 토스 랭킹 API 상한이 100 건)
QUOTE_UNIVERSE_SIZE=100
# 이 시간(초)보다 오래된 시세로는 주문을 체결하지 않습니다
QUOTE_MAX_STALENESS_SECONDS=15
# 외부 시장 데이터 준비가 끝난 뒤 계좌 락을 기다릴 수 있는 최대 시간(초)
EXECUTION_CONTEXT_MAX_AGE_SECONDS=15

# ── 거래 정책 ────────────────────────────────────────────────────────────────
#
# [여기 값들은 "덮어쓰기"용입니다. 비워둬도 앱은 정상 동작합니다]
#   기본값은 back/src/main/resources/application.yml 의 trading.* 에 있습니다.
#   요율은 비밀값이 아니라 정책이라, 커밋되는 파일에 기본값을 두는 편이
#   팀원마다 값이 갈리는 사고를 막아줍니다.
#   실험 삼아 요율을 바꿔보고 싶을 때만 아래 주석을 푸세요.
#
# [요율은 DB 에 저장하지 않습니다]
#   테이블에는 계산 "결과값"만 들어갑니다 — trade_order.fee / trade_order.tax.
#   요율은 주문마다 다른 값이 아니라 전역 정책이라, 주문 행마다 복사하면
#   정책이 바뀔 때 어디가 진실인지 모호해집니다.
#   결과 금액이 남아 있으면 요율이 바뀌어도 과거 거래는 그대로 보존됩니다.
#
# [계산식]
#   매수          net = gross + fee
#   매도(국내)    net = gross - fee - k_tax
#   매도(미국)    net = gross - fee - a_tax
#
#     fee   = gross x FEE_RATE
#     k_tax = gross x K_TAX_RATE
#     a_tax = max(gross x A_TAX_RATE, A_TAX_MIN_USD x 환율)
#
#   원화 환산 금액은 원 단위 반올림(HALF_UP) 후 정수로 저장합니다.

# INITIAL_CASH=50000000

# 거래 수수료 0.01% - 매수·매도 공통, 국내·미국 공통
# FEE_RATE=0.0001

# 한국 증권거래세 0.2% - 매도 시에만.
#   실제 국내 세율은 0.15% 지만 모의투자임을 분명히 하려고 다르게 잡았습니다.
# K_TAX_RATE=0.002

# 미국 증권거래세(SEC Fee, Section 31) - 매도 시에만.
#   $20.60 per million = 0.0000206. FY2026 기준이며 SEC 가 연 1회 조정합니다.
#   최소 $0.01 이 있어서, $485.44 미만 매도는 전부 최소액이 적용됩니다.
#   (0.01 / 0.0000206 = 485.44)
# A_TAX_RATE=0.0000206
# A_TAX_MIN_USD=0.01


# 변경 후:
# ── JWT 인증 설정 ────────────────────────────────────────────────────────────
# openssl rand -base64 32 로 생성한 값을 로컬 환경에만 설정합니다.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
